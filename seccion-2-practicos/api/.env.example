# Puerto de la API
PORT=3000

# Conexión a MongoDB 
MONGODB_URI=mongodb://localhost:27017/tareas

# Token fijo que deben enviar los clientes:  Authorization: Bearer <token>
API_TOKEN=cambia-este-token

# Orígenes permitidos por CORS, separados por coma (* = todos)
CORS_ORIGIN=*

# Almacenamiento de adjuntos: "local" (carpeta uploads/) o "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Solo si STORAGE_DRIVER=s3
# En EC2 usa un rol IAM en lugar de llaves; en local, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET=
